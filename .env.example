# U.S. Census API — free, no key required
# CENSUS_API_KEY=

# WalkScore API — free tier at walkscore.com/professional/api.php
WALKSCORE_API_KEY=your_walkscore_api_key_here

# FRED API — free at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# NewsAPI — free tier at newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Anthropic Claude API — console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
