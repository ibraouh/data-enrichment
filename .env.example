# Supabase — supabase.com (service key for backend, anon key for frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# HUD Fair Market Rents — free token at huduser.gov/hudapi/public/register
HUD_API_KEY=your_hud_api_key_here

# FRED API — free at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# NewsAPI — free tier at newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Anthropic Claude API — console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets — path to service account JSON file, or raw JSON string
# Create a service account in GCP Console → IAM → Service Accounts, then share
# your target sheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# U.S. Census API — free, no key required
# CENSUS_API_KEY=
